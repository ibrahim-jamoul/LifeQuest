{
  "name": "lifequest-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "run-p --race dev:api dev:web",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:e2e": "run-p --race dev:e2e:api dev:e2e:web",
    "dev:e2e:api": "tsx watch server/index.ts",
    "dev:e2e:web": "vite --port 3100",
    "build": "tsc -b && vite build && npm run build:api",
    "build:api": "node tools/build-vercel-api.mjs",
    "start": "tsx server/index.ts",
    "db:init": "tsx server/db/init.ts",
    "db:migrate": "tsx server/db/init.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:postgres:verify": "tsx server/db/postgresVerify.ts",
    "db:postgres:smoke": "tsx server/db/postgresSmokeTest.ts",
    "db:postgres:migrate-data": "tsx server/db/postgresMigrateData.ts",
    "db:postgres:integration": "tsx server/db/postgresApiIntegration.ts",
    "db:postgres:rotate-passwords": "tsx server/db/postgresRotateDemoPasswords.ts",
    "deployment:smoke": "tsx server/deploymentSmokeTest.ts",
    "test": "vitest run --no-file-parallelism",
    "e2e:prepare": "node tools/prepare-e2e.mjs",
    "test:e2e": "playwright test tests/e2e/"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.2",
    "recharts": "^2.12.7",
    "zod": "^3.25.64",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.31",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.0",
    "npm-run-all2": "^9.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.3"
  }
}
